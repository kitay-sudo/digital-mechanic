# Скопируйте в .env и заполните. Файл .env в Git не попадает.

# --- Внешние сервисы (F6 ТЗ) ---
# В docker compose по умолчанию используются заглушки заказчика из папки mocks.
# Для локального запуска без Docker:
# MOCK_ML_URL=http://127.0.0.1:8001
# MOCK_TOIR_URL=http://127.0.0.1:8002

# --- Модель ---
# mock        — заглушка модели, работает без ключа (для проверки пути и тестов)
# anthropic   — Claude по ключу: напрямую или через шлюз с форматом Anthropic Messages
# claude_code — локальный Claude Code, только для разработки без Docker (нужен `claude auth login`)
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# openai      — сервер с форматом OpenAI: локальная модель в контуре (Ollama, vLLM) или шлюз
# Локальная модель, данные не уходят наружу. Требования к модели и железу: docs/local-model.md
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=имя_модели_на_сервере
# LLM_API_KEY=
# json — вызовы инструментов одним JSON-объектом (надёжнее для локальных моделей); native — встроенные функции
# LLM_TOOLS=json
# schema — JSON-схема ответа; json — только «ответ в JSON»; off — схема лишь в инструкции
# LLM_STRUCTURED=schema
# LLM_MAX_TOKENS=6000
# Локальная модель бесплатна по токенам: поставьте цены 0, стоимость считается по железу.

# Российское облако, Yandex AI Studio (данные обрабатываются в России). Тот же слой openai.
# Модели и их адреса: https://aistudio.yandex.ru/ru/docs/ai-studio/concepts/generation/models
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_API_KEY=ключ_AI_Studio
# LLM_PROJECT=идентификатор_каталога
# LLM_MODEL=gpt://идентификатор_каталога/yandexgpt-5.1
# Если сервис не примет JSON-схему ответа: LLM_STRUCTURED=json

# Через ProxyAPI (доступ из России, оплата в рублях). Формат запросов тот же, меняются адрес и ключ.
# Цены смотрите на https://proxyapi.ru/models/anthropic и впишите ниже в рублях.
# LLM_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://api.proxyapi.ru
# ANTHROPIC_API_KEY=ключ_ProxyAPI
# LLM_MODEL=anthropic/claude-opus-5-5
# PRICE_CURRENCY=RUB
# Что из возможностей принимает ваш ключ, покажет проверка (из папки backend): uv run python -m eval.preflight
# Не принятое выключается здесь:
# LLM_FALLBACKS=0
# LLM_STRUCTURED=off
# LLM_STRICT_TOOLS=0
# LLM_THINKING=off
# LLM_CACHE=0
# LLM_EFFORT=off

# --- Цены для журнала стоимости (за 1 млн токенов, без НДС) ---
PRICE_INPUT_PER_MTOK=4.0
PRICE_OUTPUT_PER_MTOK=20.0
PRICE_CACHE_READ_PER_MTOK=0.2
PRICE_CURRENCY=USD
# Курс ЦБ РФ на 26.11.2026, рублей за доллар. Нужен, чтобы стоимость показывалась в рублях.
USD_RATE=0

# --- Правила ---
# Порог уверенности модели: ниже него заявка не оформляется, нужна повторная проверка.
CONFIDENCE_MIN=0.5

# --- База знаний и данные (для локального запуска без Docker) ---
# KB_DIR=./knowledge
# DATA_DIR=./data

# Стенд в интернете: https для домена из DOMAIN. Сертификат Let's Encrypt Caddy выпускает и продлевает сам,
# нужно только, чтобы домен смотрел на сервер, а порты 80 и 443 были свободны.
{$DOMAIN} {
	encode zstd gzip
	# Ход агента приходит потоком событий: без буферизации механик видит шаги сразу
	reverse_proxy frontend:3000 {
		flush_interval -1
	}
}
